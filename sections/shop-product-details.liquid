{% schema %}
{
  "name": "Product Details",
  "class": "shop-product-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_theme_colors",
      "label": "Use Theme Colors",
      "default": true,
      "info": "When enabled, the section will use your global theme colors"
    },
    {
      "type": "product",
      "id": "current_product",
      "label": "Selected product",
      "info": "Apply this setting only when the section is used on a non-product page."
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section background color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "blocks_spacing",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 4,
      "label": "Spacing between blocks (px)"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#EF4A65"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#EEEEEE"
    },
    {
      "type": "checkbox",
      "id": "show_product_info",
      "label": "Show product information",
      "default": true
    },
    {
      "type": "header",
      "content": "Image Gallery Settings"
    },
    {
      "type": "checkbox",
      "id": "show_product_gallery",
      "label": "Show product gallery",
      "default": true,
      "info": "Turn off to hide the product images and gallery completely"
    },
    {
      "type": "checkbox",
      "id": "show_product_variants",
      "label": "Hide variants' images in the product gallery",
      "default": true,
      "info": "Turn off to hide the variants' images in the gallery"
    },
    {
      "type": "color",
      "id": "thumbnail_border_color",
      "label": "Thumbnail border color",
      "default": "#EEEEEE"
    },
    {
      "type": "color",
      "id": "thumbnail_active_border_color",
      "label": "Thumbnail active border",
      "default": "#EF4A65"
    },

    {
      "type": "color",
      "id": "dots_color",
      "label": "Navigation dots color",
      "default": "#CCCCCC"
    },
    {
      "type": "checkbox",
      "id": "enable_full_width_image",
      "label": "Enable mobile dynamic image height",
      "default": false,
      "info": "MOBILE ONLY: When enabled, the image container on mobile devices adjusts its height to match the image's natural aspect ratio. Vertical images (like 3:4 or 2:3) will display at full width without whitespace on the sides. Desktop maintains square layout."
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_full_width_image",
      "label": "Enable mobile full-width image",
      "default": false,
      "info": "When enabled, removes all padding around the image on mobile devices for a full-width display"
    },
    {
      "type": "checkbox",
      "id": "hide_thumbnails",
      "label": "Hide product thumbnails",
      "default": false,
      "info": "When enabled, thumbnails will be hidden and replaced with navigation dots"
    },
    {
      "type": "range",
      "id": "dot_size",
      "min": 6,
      "max": 16,
      "step": 1,
      "default": 8,
      "label": "Dot size (px)",
      "info": "Size of navigation dots when thumbnails are hidden"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "default": "#cccccc",
      "info": "Color of inactive navigation dots"
    },
    {
      "type": "color",
      "id": "dot_active_color",
      "label": "Active dot color",
      "default": "#000000",
      "info": "Color of active navigation dot"
    },
    {
      "type": "header",
      "content": "Navigation Arrow Styling"
    },
    {
      "type": "paragraph",
      "content": "These colors apply to both desktop and mobile navigation arrows"
    },
    {
      "type": "checkbox",
      "id": "show_desktop_arrows",
      "label": "Show desktop navigation arrows",
      "default": false,
      "info": "When enabled, navigation arrows will appear on desktop screens - placement controlled by the setting below"
    },
    {
      "type": "color",
      "id": "desktop_arrow_background",
      "label": "Arrow background color",
      "default": "#ffffff",
      "info": "Background color of the arrow buttons (applies to both desktop and mobile)"
    },
    {
      "type": "color",
      "id": "desktop_arrow_border",
      "label": "Arrow border color",
      "default": "#e0e0e0",
      "info": "Border color of the arrow buttons (applies to both desktop and mobile)"
    },
    {
      "type": "color",
      "id": "desktop_arrow_icon",
      "label": "Arrow icon color",
      "default": "#000000",
      "info": "Color of the arrow icons and press/focus border (applies to both desktop and mobile)"
    },
    {
      "type": "color",
      "id": "desktop_arrow_hover_background",
      "label": "Arrow hover background color",
      "default": "#f5f5f5",
      "info": "Background color when hovering over desktop arrow buttons"
    },
    {
      "type": "color",
      "id": "desktop_arrow_hover_border",
      "label": "Arrow hover border color",
      "default": "#d0d0d0",
      "info": "Border color when hovering over desktop arrow buttons"
    },
    {
      "type": "range",
      "id": "arrow_border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "Arrow border radius",
      "default": 50,
      "info": "Border radius for navigation arrows (0 = square, 50 = fully rounded)"
    },
    {
      "type": "range",
      "id": "arrow_opacity",
      "min": 50,
      "max": 100,
      "step": 5,
      "default": 90,
      "label": "Arrow opacity (%)",
      "info": "Controls transparency of navigation arrow buttons - applies to both desktop and mobile arrows when overlaid"
    },
    {
      "type": "select",
      "id": "desktop_arrow_placement",
      "label": "Desktop arrow placement",
      "options": [
        {
          "value": "overlaid",
          "label": "Overlaid on image"
        },
        {
          "value": "below",
          "label": "Below thumbnails/dots"
        }
      ],
      "default": "overlaid",
      "info": "Choose where desktop arrows appear: overlaid on the main image or below the thumbnails and navigation dots"
    },
    {
      "type": "header",
      "content": "Mobile Navigation Arrows"
    },
    {
      "type": "checkbox",
      "id": "show_mobile_arrows",
      "label": "Show mobile navigation arrows",
      "default": false,
      "info": "When enabled, navigation arrows will appear on mobile screens - placement controlled by the setting below"
    },

    {
      "type": "select",
      "id": "mobile_arrow_placement",
      "label": "Mobile arrow placement",
      "options": [
        {
          "value": "overlaid",
          "label": "Overlaid on image"
        },
        {
          "value": "below",
          "label": "Below thumbnails/dots"
        }
      ],
      "default": "overlaid",
      "info": "Choose where mobile arrows appear: overlaid on the main image or below the thumbnails and navigation dots"
    },
    {
      "type": "checkbox",
      "id": "mobile_thumbnails_2x2_grid",
      "label": "Fit 4 thumbnails in row on mobile",
      "default": false,
      "info": "When mobile arrows are disabled, arrange thumbnails in a compact single row that fits 4 images on mobile screens"
    },
    {
      "type": "header",
      "content": "Variant Selector Settings"
    },
    {
      "type": "checkbox",
      "id": "show_variant_selector",
      "label": "Show variant selector",
      "default": true,
      "info": "Display a custom variant selector with customizable styling"
    },
    {
      "type": "color",
      "id": "variant_border_color",
      "label": "Variant card border color",
      "default": "#e5e7eb"
    },
    {
      "type": "color",
      "id": "variant_hover_border_color",
      "label": "Variant card hover border color",
      "default": "#3b82f6"
    },

      "settings": {
        "custom_liquid": "<div class=\"onirala-guarantees\">\n  <div class=\"onirala-guarantees__grid\">\n\n    <div class=\"onirala-guarantees__item\">\n      <div class=\"onirala-guarantees__icon\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"/><polyline points=\"3.27 6.96 12 12.01 20.73 6.96\"/><line x1=\"12\" y1=\"22.08\" x2=\"12\" y2=\"12\"/></svg>\n      </div>\n      <h3 class=\"onirala-guarantees__title\">Livraison suivie</h3>\n      <p class=\"onirala-guarantees__text\">Expédition rapide et numéro de suivi fourni.</p>\n    </div>\n\n    <div class=\"onirala-guarantees__item\">\n      <div class=\"onirala-guarantees__icon\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3a9 9 0 0 0-9 9v4a2 2 0 0 0 2 2h1v-6H5a7 7 0 0 1 14 0h-1v6h1a2 2 0 0 0 2-2v-4a9 9 0 0 0-9-9z\"/></svg>\n      </div>\n      <h3 class=\"onirala-guarantees__title\">Support réactif</h3>\n      <p class=\"onirala-guarantees__text\">Une question ? Réponse rapide par email.</p>\n    </div>\n\n    <div class=\"onirala-guarantees__item\">\n      <div class=\"onirala-guarantees__icon\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 12l2 2 4-4\"/><path d=\"M12 3l7 4v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V7l7-4z\"/></svg>\n      </div>\n      <h3 class=\"onirala-guarantees__title\">Qualité vérifiée</h3>\n      <p class=\"onirala-guarantees__text\">Chaque masque contrôlé avant l'envoi.</p>\n    </div>\n\n    <div class=\"onirala-guarantees__item\">\n      <div class=\"onirala-guarantees__icon\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"1 4 1 10 7 10\"/><path d=\"M3.51 15a9 9 0 1 0 2.13-9.36L1 10\"/></svg>\n      </div>\n      <h3 class=\"onirala-guarantees__title\">Satisfait ou remboursé</h3>\n      <p class=\"onirala-guarantees__text\">30 jours pour changer d'avis, sans stress.</p>\n    </div>\n\n  </div>\n</div>\n\n<style>\n  .onirala-guarantees{background:#FBFAF7;padding:64px 24px;}\n  .onirala-guarantees__grid{max-width:1140px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:24px;}\n  .onirala-guarantees__item{background:#FBFAF7;border:1px solid rgba(201,169,106,0.22);border-radius:14px;padding:34px 22px;text-align:center;transition:transform .25s ease,border-color .25s ease;}\n  .onirala-guarantees__item:hover{transform:translateY(-4px);border-color:rgba(201,169,106,0.55);}\n  .onirala-guarantees__icon{width:48px;height:48px;margin:0 auto 18px;color:#55584A;}\n  .onirala-guarantees__icon svg{width:48px;height:48px;display:block;}\n  .onirala-guarantees__title{font-family:'Cormorant',serif;font-size:21px;color:#21201C;margin:0 0 8px;}\n  .onirala-guarantees__text{font-size:13.5px;line-height:1.5;color:rgba(245,241,232,0.62);margin:0;}\n  @media (max-width:900px){.onirala-guarantees__grid{grid-template-columns:repeat(2,1fr);}}\n  @media (max-width:500px){.onirala-guarantees__grid{grid-template-columns:1fr;}}\n</style>",

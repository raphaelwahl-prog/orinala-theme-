    "custom_liquid_p8K74d": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .vs-section {\n    max-width: 900px;\n    margin: 0 auto;\n    padding: 20px 15px;\n    font-family: inherit;\n    color: #21201C;\n  }\n\n  .vs-header {\n    text-align: center;\n    margin-bottom: 30px;\n  }\n\n  .vs-header h2 {\n    font-size: 28px;\n    font-weight: 700;\n    color: #21201C;\n    margin-bottom: 8px;\n  }\n\n  .vs-header h2 span {\n    color: #55584A;\n  }\n\n  .vs-header p {\n    font-size: 15px;\n    color: #6E6A5E;\n    margin: 0;\n  }\n\n  .vs-table-wrapper {\n    overflow-x: auto;\n    border-radius: 12px;\n    border: 1px solid rgba(212, 175, 55, 0.2);\n    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);\n  }\n\n  .vs-table {\n    width: 100%;\n    border-collapse: collapse;\n    background-color: rgba(15, 23, 42, 0.6);\n    text-align: left;\n  }\n\n  .vs-table th, .vs-table td {\n    padding: 16px 20px;\n    border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n  }\n\n  .vs-table th {\n    font-weight: 600;\n    font-size: 16px;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n  }\n\n  .vs-table th.our-brand {\n    background: linear-gradient(180deg, rgba(212, 175, 55, 0.25) 0%, rgba(212, 175, 55, 0.1) 100%);\n    color: #55584A;\n    text-align: center;\n    border-top-left-radius: 8px;\n    border-top-right-radius: 8px;\n  }\n\n  .vs-table th.others {\n    text-align: center;\n    color: #6E6A5E;\n  }\n\n  .vs-table td.center {\n    text-align: center;\n  }\n\n  .vs-table td.our-brand-cell {\n    background-color: rgba(212, 175, 55, 0.05);\n    font-weight: 600;\n  }\n\n  .check-icon {\n    color: #10b981;\n    font-size: 18px;\n    font-weight: bold;\n  }\n\n  .cross-icon {\n    color: #ef4444;\n    font-size: 18px;\n    font-weight: bold;\n  }\n\n  .vs-cta-container {\n    text-align: center;\n    margin-top: 35px;\n  }\n\n  .vs-cta-button {\n    display: inline-block;\n    background: linear-gradient(135deg, #55584A 0%, #6B6E5C 50%, #43463A 100%);\n    color: #21201C;\n    font-weight: 700;\n    font-size: 16px;\n    padding: 16px 40px;\n    border-radius: 50px;\n    text-decoration: none;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    box-shadow: 0 4px 15px rgba(212, 175, 55, 0.4);\n    transition: transform 0.2s ease, box-shadow 0.2s ease;\n    cursor: pointer;\n    border: none;\n  }\n\n  .vs-cta-button:hover {\n    transform: translateY(-2px);\n    box-shadow: 0 6px 20px rgba(212, 175, 55, 0.6);\n  }\n\n  @media (max-width: 600px) {\n    .vs-table th, .vs-table td {\n      padding: 12px 10px;\n      font-size: 13px;\n    }\n    .vs-cta-button {\n      width: 100%;\n      box-sizing: border-box;\n    }\n  }\n</style>\n\n<div class=\"vs-section\">\n  <div class=\"vs-header\">\n    <h2>Notre Masque <span>vs Les Autres</span></h2>\n    <p>Découvrez pourquoi notre solution offre la meilleure qualité de sommeil.</p>\n  </div>\n\n  <div class=\"vs-table-wrapper\">\n    <table class=\"vs-table\">\n      <thead>\n        <tr>\n          <th>Caractéristiques</th>\n          <th class=\"our-brand\">Notre Masque 🏆</th>\n          <th class=\"others\">Masques Classiques</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td><strong>Occultation de la lumière</strong></td>\n          <td class=\"our-brand-cell center\"><span class=\"check-icon\">✓</span> 100% Totale (3D)</td>\n          <td class=\"center\"><span class=\"cross-icon\">✕</span> Partielle (Fuites)</td>\n        </tr>\n        <tr>\n          <td><strong>Pression sur les yeux</strong></td>\n          <td class=\"our-brand-cell center\"><span class=\"check-icon\">✓</span> Aucune (Cavités 3D)</td>\n          <td class=\"center\"><span class=\"cross-icon\">✕</span> Pression directe</td>\n        </tr>\n        <tr>\n          <td><strong>Matériaux respirants</strong></td>\n          <td class=\"our-brand-cell center\"><span class=\"check-icon\">✓</span> Oui (Anti-transpiration)</td>\n          <td class=\"center\"><span class=\"cross-icon\">✕</span> Tissus chauds / Synthétiques</td>\n        </tr>\n        <tr>\n          <td><strong>Sangle réglable de précision</strong></td>\n          <td class=\"our-brand-cell center\"><span class=\"check-icon\">✓</span> Sur mesure (Sans gêne)</td>\n          <td class=\"center\"><span class=\"cross-icon\">✕</span> Élastiques basiques</td>\n        </tr>\n        <tr>\n          <td><strong>Sûreté (Sans produits chimiques)</strong></td>\n          <td class=\"our-brand-cell center\"><span class=\"check-icon\">✓</span> Certifiée toxique-free</td>\n          <td class=\"center\"><span class=\"cross-icon\">✕</span> Non garantie</td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n\n  <div class=\"vs-cta-container\">\n    <button type=\"button\" class=\"vs-cta-button\" id=\"custom-scroll-btn\">\n      Obtenir le mien maintenant\n    </button>\n  </div>\n</div>\n\n<script>\n  document.getElementById('custom-scroll-btn').addEventListener('click', function(e) {\n    e.preventDefault();\n    \n    const startPosition = window.pageYOffset;\n    const duration = 1200; // Durée de la remontée en ms (1.2 secondes = très doux)\n    let startTime = null;\n\n    function easeInOutCubic(t, b, c, d) {\n      t /= d / 2;\n      if (t < 1) return c / 2 * t * t * t + b;\n      t -= 2;\n      return c / 2 * (t * t * t + 2) + b;\n    }\n\n    function animation(currentTime) {\n      if (startTime === null) startTime = currentTime;\n      const timeElapsed = currentTime - startTime;\n      const run = easeInOutCubic(timeElapsed, startPosition, -startPosition, duration);\n      window.scrollTo(0, run);\n      if (timeElapsed < duration) requestAnimationFrame(animation);\n    }\n\n    requestAnimationFrame(animation);\n  });\n</script>",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },

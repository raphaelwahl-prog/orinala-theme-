        "custom_liquid_xQNtGz": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"pfr-card\"><div class=\"pfr-head\"><span class=\"pfr-avatar\">C</span><div><p class=\"pfr-name\">Camille R., 34 ans — Lyon</p><p class=\"pfr-verified\">Achat vérifié</p></div><span class=\"pfr-stars\">★★★★★</span></div><p class=\"pfr-text\">« Je travaille de nuit et je dors le jour. C'est le premier masque qui bloque vraiment toute la lumière, sans appuyer sur les yeux. Je peux même ouvrir les yeux dessous, rien ne touche mes cils. Endormissement beaucoup plus rapide depuis que je l'utilise. »</p></div>\n<style>\n.pfr-card{max-width:470px;margin:18px auto 0;padding:18px 20px;border:1px solid rgba(240,205,79,.28);border-radius:12px;background:#16203A}\n.pfr-head{display:flex;align-items:center;gap:10px;margin-bottom:10px}\n.pfr-avatar{width:34px;height:34px;border-radius:50%;background:#F0CD4F;color:#0B1120;display:flex;align-items:center;justify-content:center;font-weight:600;font-size:14px;flex:0 0 34px}\n.pfr-name{margin:0;font-size:13.5px;font-weight:600;color:#F2F5FA}\n.pfr-verified{margin:1px 0 0;font-size:11.5px;color:#F0CD4F}\n.pfr-stars{margin-left:auto;color:#F0CD4F;font-size:13px;letter-spacing:1px}\n.pfr-text{margin:0;font-size:13.5px;line-height:1.6;color:#9AA8C0}\n</style>"

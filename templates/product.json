    "store_faq_Lpd3PW": {
      "type": "store-faq",
      "blocks": {
        "faq_item_YYJUL8": {
          "type": "faq_item",
          "settings": {
            "question": "Est-ce qu'il bloque vraiment toute la lumière ?",
            "answer": "<p>Oui. Les contours sont moulés pour épouser l'arête du nez et les pommettes, la zone par laquelle la lumière passe sur un masque plat classique. Résultat : une obscurité totale, même en plein jour.</p>"
          }
        },
        "faq_item_xAnE8L": {
          "type": "faq_item",
          "settings": {
            "question": "Est-ce qu'il appuie sur les yeux ?",
            "answer": "<p>Non. La coque 3D crée deux cavités devant les yeux. Vous pouvez cligner et ouvrir les yeux librement sous le masque : rien ne touche vos paupières ni vos cils.</p>"
          }
        },
        "faq_item_AUEi9b": {
          "type": "faq_item",
          "settings": {
            "question": "Convient-il à toutes les tailles de tête ?",
            "answer": "<p>Oui. La sangle est réglable de 52 à 68 cm environ, avec une fermeture plate qui ne se sent pas quand vous dormez sur le côté ou sur le dos.</p>"
          }
        },
        "faq_item_MhA9QW": {
          "type": "faq_item",
          "settings": {
            "question": "Est-ce qu'il tient bien la nuit entière ?",
            "answer": "<p>Oui. Le maintien est assuré par la sangle réglable et la mousse à mémoire de forme qui épouse le visage. Il reste en place même en changeant de position.</p>"
          }
        },
        "faq_item_QKVnRn": {
          "type": "faq_item",
          "settings": {
            "question": "Fait-il transpirer ?",
            "answer": "<p>Non. L'intérieur associe une mousse à mémoire de forme à un tissu maillé respirant, qui évacue la chaleur et l'humidité tout au long de la nuit.</p>"
          }
        },
        "faq_item_Dnc6cV": {
          "type": "faq_item",
          "settings": {
            "question": "Comment l'entretenir ?",
            "answer": "<p>Lavage à la main à l'eau tiède avec un savon doux, puis séchage à l'air libre. Ne pas passer au sèche-linge afin de préserver la forme de la coque.</p>"
          }
        },
        "faq_item_appL6A": {
          "type": "faq_item",
          "settings": {
            "question": "Quels sont les délais de livraison et la garantie ?",
            "answer": "<p>Expédition rapide avec numéro de suivi fourni. Vous disposez de 30 jours pour l'essayer : s'il ne vous convient pas, il est remboursé.</p>"
          }
        }
      },

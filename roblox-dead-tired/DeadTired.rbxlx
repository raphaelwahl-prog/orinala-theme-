	}, { UiKit.corner(10), UiKit.padding(10) })

	refs.PhaseLabel = new(&quot;TextLabel&quot;, {
		Parent = panel,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 16),
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextColor3 = Colors.Muted,

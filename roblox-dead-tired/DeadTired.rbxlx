	})

	-- Barre qui se vide : le temps avant le prochain tirage de risque.
	local track = new(&quot;Frame&quot;, {
		Parent = panel,
		Position = UDim2.fromOffset(0, 70),
		Size = UDim2.new(1, 0, 0, 6),

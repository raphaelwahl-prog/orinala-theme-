		Size = UDim2.fromOffset(600, 70),
		Font = Enum.Font.GothamBlack,
		TextSize = 44,
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0.2,
		Text = &quot;IL ARRIVE — COURS&quot;,
	})
end

local function buildDowned(parent: Instance)
	refs.DownedFrame = new(&quot;Frame&quot;, {
		Name = &quot;Downed&quot;,
		Parent = parent,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 4,
	})

	refs.DownedTitle = new(&quot;TextLabel&quot;, {
		Parent = refs.DownedFrame,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(700, 48),
		Font = Enum.Font.GothamBlack,
		TextSize = 34,
		TextColor3 = Colors.Danger,
		Text = &quot;À TERRE&quot;,
	})

	refs.DownedInfo = new(&quot;TextLabel&quot;, {
		Parent = refs.DownedFrame,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(700, 28),
		Font = Enum.Font.Gotham,
		TextSize = 18,
		TextColor3 = Colors.Text,
		Text = &quot;&quot;,
	})

	local track = new(&quot;Frame&quot;, {
		Parent = refs.DownedFrame,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.56),
		Size = UDim2.fromOffset(360, 8),
		BackgroundColor3 = Colors.PanelLight,
		BorderSizePixel = 0,
	}, { UiKit.corner(4) })

	refs.DownedBar = new(&quot;Frame&quot;, {
		Parent = track,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Colors.Danger,
		BorderSizePixel = 0,
	}, { UiKit.corner(4) })
end

--[[ La jauge d'ÉVEIL : le joueur doit voir que SES choix de planque réveillent
	 la maison. Sans cet affichage, l'évolution des créatures passerait pour de
	 l'arbitraire — et un joueur qui trouve le jeu arbitraire s'en va. ]]
local function buildAwakening(parent: Instance)
	local panel = new(&quot;Frame&quot;, {
		Name = &quot;Awakening&quot;,
		Parent = parent,
		BackgroundColor3 = Colors.Panel,
		BackgroundTransparency = 0.15,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 16),
		Size = UDim2.fromOffset(212, 86),
	}, { UiKit.corner(10), UiKit.padding(12) })

	new(&quot;TextLabel&quot;, {
		Parent = panel,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 14),
		Font = Enum.Font.Gotham,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Colors.Muted,
		Text = &quot;ÉVEIL DE LA MAISON&quot;,
	})

	refs.AwakeningName = new(&quot;TextLabel&quot;, {
		Parent = panel,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 16),
		Size = UDim2.new(1, 0, 0, 22),
		Font = Enum.Font.GothamBold,
		TextSize = 19,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Colors.Text,
		Text = &quot;CALME&quot;,
	})

	-- Quatre segments : on lit le stade d'un coup d'oeil, sans chiffre.
	local segments = new(&quot;Frame&quot;, {
		Parent = panel,
		Position = UDim2.fromOffset(0, 42),
		Size = UDim2.new(1, 0, 0, 7),
		BackgroundTransparency = 1,
	}, {
		new(&quot;UIListLayout&quot;, {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 4),
		}),
	})

	refs.AwakeningSegments = {}
	for index = 1, 4 do
		refs.AwakeningSegments[index] = new(&quot;Frame&quot;, {
			Parent = segments,
			LayoutOrder = index,
			Size = UDim2.new(0.25, -3, 1, 0),
			BackgroundColor3 = Colors.PanelLight,
			BorderSizePixel = 0,
		}, { UiKit.corner(3) })
	end

	refs.AwakeningHint = new(&quot;TextLabel&quot;, {
		Parent = panel,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 0, 14),
		Font = Enum.Font.Gotham,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Colors.Muted,
		Text = &quot;dormir profond la réveille&quot;,
	})
end

--[[ Première rencontre avec une créature : on affiche son nom ET sa
	 contre-mesure. Un joueur qui meurt sans comprendre pourquoi ne revient
	 pas ; un joueur qui meurt en sachant ce qu'il aurait dû faire relance. ]]
local function buildReveal(parent: Instance)
	refs.RevealFrame = new(&quot;Frame&quot;, {
		Name = &quot;Reveal&quot;,
		Parent = parent,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.25,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 8,
	})

	local card = new(&quot;Frame&quot;, {
		Parent = refs.RevealFrame,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(520, 220),
		BackgroundColor3 = Colors.Panel,
		BackgroundTransparency = 0.02,
	}, { UiKit.corner(14), UiKit.padding(22) })

	new(&quot;TextLabel&quot;, {
		Parent = card,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 16),
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Colors.Muted,
		Text = &quot;TU VIENS D'EN RÉVEILLER UN&quot;,
	})

	refs.RevealName = new(&quot;TextLabel&quot;, {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 20),
		Size = UDim2.new(1, 0, 0, 42),
		Font = Enum.Font.GothamBlack,
		TextSize = 36,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Colors.Danger,
		Text = &quot;LE VEILLEUR&quot;,
	})

	refs.RevealTagline = new(&quot;TextLabel&quot;, {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 66),
		Size = UDim2.new(1, 0, 0, 40),
		Font = Enum.Font.GothamMedium,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		TextColor3 = Colors.Text,
		Text = &quot;&quot;,
	})

	new(&quot;TextLabel&quot;, {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 118),
		Size = UDim2.new(1, 0, 0, 14),
		Font = Enum.Font.Gotham,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Colors.Muted,
		Text = &quot;COMMENT T'EN SORTIR&quot;,
	})

	refs.RevealCounter = new(&quot;TextLabel&quot;, {
		Parent = card,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 136),
		Size = UDim2.new(1, 0, 0, 44),
		Font = Enum.Font.GothamBold,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		TextColor3 = Colors.Cash,
		Text = &quot;&quot;,
	})
end

local function buildToasts(parent: Instance)
	refs.ToastList = new(&quot;Frame&quot;, {
		Name = &quot;Toasts&quot;,
		Parent = parent,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, -16),
		Size = UDim2.fromOffset(340, 220),
	}, {
		new(&quot;UIListLayout&quot;, {
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			Padding = UDim.new(0, 6),
		}),
	})
end

function Hud.build(parentGui: ScreenGui)
	gui = parentGui
	buildWallet(gui)
	buildClock(gui)
	buildSleepPanel(gui)
	buildAwakening(gui)
	buildReveal(gui)
	buildDanger(gui)
	buildDowned(gui)
	buildToasts(gui)
end

-- ─── mises à jour venues du serveur ─────────────────────────────────────────

function Hud.setState(newState)
	state = newState
end

function Hud.setRound(newRound)
	round = newRound
end

function Hud.setAwakening(data)
	awakening = data
end

function Hud.revealEntity(data)
	refs.RevealName.Text = data.Name or &quot;?&quot;
	refs.RevealName.TextColor3 = data.EyeColor or Colors.Danger
	refs.RevealTagline.Text = data.Tagline or &quot;&quot;
	refs.RevealCounter.Text = data.Counter or &quot;&quot;
	refs.RevealFrame.Visible = true
	revealUntil = os.clock() + 6
end

function Hud.flashDanger(window: number)
	dangerUntil = os.clock() + window
	refs.DangerFrame.Visible = true
end

local toastOrder = 0

function Hud.toast(message: string, kind: string)
	toastOrder += 1

	local color = Colors.Text
	if kind == &quot;cash&quot; then
		color = Colors.Cash
	elseif kind == &quot;danger&quot; then
		color = Colors.Danger
	elseif kind == &quot;unlock&quot; then
		color = Colors.Unlock
	end

	local frame = new(&quot;Frame&quot;, {
		Parent = refs.ToastList,
		LayoutOrder = toastOrder,
		BackgroundColor3 = Colors.Panel,
		BackgroundTransparency = 0.12,
		Size = UDim2.new(1, 0, 0, 34),
	}, { UiKit.corner(8), UiKit.padding(8) })

	new(&quot;TextLabel&quot;, {
		Parent = frame,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Font = Enum.Font.Gotham,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = color,
		TextWrapped = true,
		Text = message,
	})

	task.delay(5, function()
		if frame.Parent then
			TweenService:Create(frame, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
			task.wait(0.35)
			frame:Destroy()
		end
	end)
end

-- ─── boucle d'affichage ─────────────────────────────────────────────────────

local lastUnbanked = 0

function Hud.start()
	RunService.RenderStepped:Connect(function()
		-- Porte-monnaie
		refs.CashLabel.Text = (&quot;En banque  %s&quot;):format(UiKit.money(state.Cash or 0))
		local unbanked = state.Unbanked or 0
		refs.UnbankedLabel.Text = UiKit.money(unbanked)
		refs.UnbankedLabel.TextColor3 = (unbanked &gt; 0) and Colors.Cash or Colors.Muted
		refs.UnbankedHint.TextColor3 = (unbanked &gt; 0) and Colors.Danger or Colors.Muted

		if unbanked &gt; lastUnbanked + 0.01 then
			refs.UnbankedLabel.TextSize = 28
		else
			refs.UnbankedLabel.TextSize = 26
		end
		lastUnbanked = unbanked

		-- Horloge
		local remaining = math.max(0, round.SecondsLeft - (os.clock() - (round.ReceivedAt or os.clock())))
		refs.PhaseLabel.Text = (round.Phase == &quot;Night&quot;)
			and (&quot;NUIT %d&quot;):format(round.NightNumber or 0)
			or &quot;JOUR&quot;
		refs.PhaseLabel.TextColor3 = (round.Phase == &quot;Night&quot;) and Colors.Danger or Colors.Accent
		refs.TimerLabel.Text = UiKit.clockText(remaining)

		-- Panneau de sommeil
		local sleep = state.Sleep
		if sleep then
			refs.SleepPanel.Visible = true
			refs.SleepTitle.Text = sleep.SpotLabel or sleep.TierName
			refs.SleepRate.Text = (&quot;+%.1f $/s   ·   %s gagnés ici&quot;):format(
				sleep.RatePerSecond or 0, UiKit.money(sleep.Earned or 0))
			if (sleep.RiskPercent or 0) &lt;= 0 then
				refs.SleepRisk.Text = &quot;aucun risque — mais ça ne paie rien&quot;
				refs.SleepRisk.TextColor3 = Colors.Muted
			else
				refs.SleepRisk.Text = (&quot;risque %.1f %% à chaque tirage (toutes les %d s)&quot;):format(
					sleep.RiskPercent, sleep.TickInterval or 6)
				refs.SleepRisk.TextColor3 = Colors.Danger
			end
			local fraction = 0
			if (sleep.TickInterval or 0) &gt; 0 then
				fraction = math.clamp((sleep.SecondsToNextRoll or 0) / sleep.TickInterval, 0, 1)
			end
			refs.RiskBar.Size = UDim2.fromScale(fraction, 1)
		else
			refs.SleepPanel.Visible = false
		end

		-- Éveil de la maison
		refs.AwakeningName.Text = awakening.StageName or &quot;CALME&quot;
		local stageColors = { Colors.Cash, Color3.fromRGB(230, 200, 90), Color3.fromRGB(240, 140, 70), Colors.Danger }
		local stage = awakening.Stage or 1
		refs.AwakeningName.TextColor3 = stageColors[math.clamp(stage, 1, 4)]
		for index, segment in ipairs(refs.AwakeningSegments) do
			segment.BackgroundColor3 = (index &lt;= stage)
				and stageColors[math.clamp(stage, 1, 4)]
				or Colors.PanelLight
		end
		if awakening.ToNext then
			refs.AwakeningHint.Text = (&quot;stade suivant dans %d pts&quot;):format(math.max(0, awakening.ToNext))
		else
			refs.AwakeningHint.Text = &quot;maximum — il est dehors&quot;
		end

		-- Fiche de créature
		if refs.RevealFrame.Visible and os.clock() &gt;= revealUntil then
			refs.RevealFrame.Visible = false
		end

		-- Alerte
		if refs.DangerFrame.Visible then
			local left = dangerUntil - os.clock()
			if left &lt;= -1.5 then
				refs.DangerFrame.Visible = false
				refs.DangerFrame.BackgroundTransparency = 1
			else
				local pulse = 0.78 + 0.1 * math.sin(os.clock() * 14)
				refs.DangerFrame.BackgroundTransparency = pulse
				refs.DangerLabel.Text = (left &gt; 0)
					and (&quot;IL ARRIVE — COURS   %.1f s&quot;):format(left)
					or &quot;IL EST LÀ&quot;
			end
		end

		-- À terre
		local life = state.Life
		if life and life.Down then
			refs.DownedFrame.Visible = true
			refs.DownedBar.Size = UDim2.fromScale(
				math.clamp((life.SecondsLeft or 0) / (life.BleedoutSeconds or 1), 0, 1), 1)
			if life.BeingRevivedBy then
				refs.DownedInfo.Text = (&quot;%s te relève… %d %%&quot;):format(
					life.BeingRevivedBy, math.floor((life.ReviveProgress or 0) * 100))
				refs.DownedBar.BackgroundColor3 = Colors.Cash
			else
				refs.DownedInfo.Text = (&quot;%s perdus · %d s avant de lâcher&quot;):format(
					UiKit.money(life.LostAmount or 0), math.floor(life.SecondsLeft or 0))
				refs.DownedBar.BackgroundColor3 = Colors.Danger
			end
		else
			refs.DownedFrame.Visible = false
		end
	end)
end

return Hud
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX28"><Properties><string name="Name">ShopUI</string><ProtectedString name="Source">--[[
	ShopUI — la boutique.

	Elle n'affiche que ce que le serveur lui envoie (prix et niveaux déjà
	calculés). Le client ne décide rien : il envoie juste &quot;je veux l'objet
	earplugs&quot; et il attend la réponse. C'est ce qui rend la triche inutile.
]]

local MarketplaceService = game:GetService(&quot;MarketplaceService&quot;)
local Players = game:GetService(&quot;Players&quot;)

local UiKit = require(script.Parent.UiKit)
local new = UiKit.new
local Colors = UiKit.Colors

local Shared = game:GetService(&quot;ReplicatedStorage&quot;):WaitForChild(&quot;Shared&quot;)
local Net = require(Shared.Net)

local ShopUI = {}

local player = Players.LocalPlayer
local frame: Frame
local list: ScrollingFrame
local cashLabel: TextLabel
local currentCash = 0

-- ─── construction ───────────────────────────────────────────────────────────

function ShopUI.build(gui: ScreenGui)
	frame = new(&quot;Frame&quot;, {
		Name = &quot;Shop&quot;,
		Parent = gui,
		Visible = false,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(520, 520),
		BackgroundColor3 = Colors.Panel,
		BackgroundTransparency = 0.04,
		ZIndex = 10,
	}, { UiKit.corner(14), UiKit.padding(18) }) :: Frame

	new(&quot;TextLabel&quot;, {
		Parent = frame,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -40, 0, 28),
		Font = Enum.Font.GothamBold,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Colors.Text,
		Text = &quot;Boutique&quot;,
	})

	cashLabel = new(&quot;TextLabel&quot;, {
		Parent = frame,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, -40, 0, 18),
		Font = Enum.Font.Gotham,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Colors.Cash,
		Text = &quot;0 $ en banque&quot;,
	}) :: TextLabel

	local close = new(&quot;TextButton&quot;, {
		Parent = frame,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(32, 32),
		BackgroundColor3 = Colors.PanelLight,
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		TextColor3 = Colors.Text,
		Text = &quot;✕&quot;,
		AutoButtonColor = true,
	}, { UiKit.corner(8) }) :: TextButton
	close.Activated:Connect(function()
		ShopUI.setVisible(false)
	end)

	list = new(&quot;ScrollingFrame&quot;, {
		Parent = frame,
		Position = UDim2.fromOffset(0, 58),
		Size = UDim2.new(1, 0, 1, -58),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, {
		new(&quot;UIListLayout&quot;, {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
		}),
	}) :: ScrollingFrame
end

-- ─── lignes ─────────────────────────────────────────────────────────────────

local function sectionTitle(text: string, order: number)
	new(&quot;TextLabel&quot;, {
		Parent = list,
		LayoutOrder = order,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 24),
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Colors.Muted,
		Text = text:upper(),
	})
end

local function itemRow(entry, order: number)
	local row = new(&quot;Frame&quot;, {
		Parent = list,
		LayoutOrder = order,
		Size = UDim2.new(1, -8, 0, 84),
		BackgroundColor3 = Colors.PanelLight,
		BorderSizePixel = 0,
	}, { UiKit.corner(10), UiKit.padding(12) })

	local levelText = &quot;&quot;
	if entry.MaxLevel &gt; 1 then
		levelText = (&quot;   ·   niveau %d/%d&quot;):format(entry.Owned, entry.MaxLevel)
	elseif entry.Owned &gt; 0 then
		levelText = &quot;   ·   possédé&quot;
	end

	new(&quot;TextLabel&quot;, {
		Parent = row,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -120, 0, 20),
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Colors.Text,
		Text = entry.Name .. levelText,
	})

	new(&quot;TextLabel&quot;, {
		Parent = row,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 22),
		Size = UDim2.new(1, -120, 0, 38),
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		TextColor3 = Colors.Muted,
		Text = entry.Desc,
	})

	local affordable = entry.CanBuy and currentCash &gt;= entry.Price
	local button = new(&quot;TextButton&quot;, {
		Parent = row,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(104, 38),
		BackgroundColor3 = entry.CanBuy and (affordable and Colors.Accent or Colors.Panel) or Colors.Panel,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextColor3 = affordable and Color3.new(1, 1, 1) or Colors.Muted,
		Text = entry.CanBuy and UiKit.money(entry.Price) or &quot;MAX&quot;,
		AutoButtonColor = entry.CanBuy,
	}, { UiKit.corner(8) }) :: TextButton

	if entry.CanBuy then
		button.Activated:Connect(function()
			;(Net.get(&quot;RequestBuy&quot;) :: RemoteEvent):FireServer(entry.Id)
		end)
	end
end

local function robuxRow(entry, order: number)
	local row = new(&quot;Frame&quot;, {
		Parent = list,
		LayoutOrder = order,
		Size = UDim2.new(1, -8, 0, 76),
		BackgroundColor3 = Colors.PanelLight,
		BorderSizePixel = 0,
	}, { UiKit.corner(10), UiKit.padding(12) })

	new(&quot;TextLabel&quot;, {
		Parent = row,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -120, 0, 20),
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Colors.Unlock,
		Text = entry.Name,
	})

	new(&quot;TextLabel&quot;, {
		Parent = row,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 22),
		Size = UDim2.new(1, -120, 0, 30),
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		TextColor3 = Colors.Muted,
		Text = entry.Desc,
	})

	local button = new(&quot;TextButton&quot;, {
		Parent = row,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(104, 38),
		BackgroundColor3 = entry.Owned and Colors.Panel or Colors.Unlock,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextColor3 = entry.Owned and Colors.Muted or Color3.new(1, 1, 1),
		Text = entry.Owned and &quot;ACTIF&quot; or &quot;ROBUX&quot;,
		AutoButtonColor = not entry.Owned,
	}, { UiKit.corner(8) }) :: TextButton

	if not entry.Owned then
		button.Activated:Connect(function()
			if entry.Kind == &quot;Pass&quot; then
				MarketplaceService:PromptGamePassPurchase(player, entry.Id)
			else
				MarketplaceService:PromptProductPurchase(player, entry.Id)
			end
		end)
	end
end

-- ─── rendu ──────────────────────────────────────────────────────────────────

function ShopUI.render(catalog)
	for _, child in ipairs(list:GetChildren()) do
		if not child:IsA(&quot;UIListLayout&quot;) then
			child:Destroy()
		end
	end

	local order = 0
	sectionTitle(&quot;Équipement&quot;, order)
	order += 1
	for _, entry in ipairs(catalog.Items or {}) do
		order += 1
		itemRow(entry, order)
	end

	if catalog.Robux and #catalog.Robux &gt; 0 then
		order += 1
		sectionTitle(&quot;Robux&quot;, order)
		for _, entry in ipairs(catalog.Robux) do
			order += 1
			robuxRow(entry, order)
		end
	end
end

function ShopUI.setCash(amount: number)
	currentCash = amount
	if cashLabel then
		cashLabel.Text = (&quot;%s en banque&quot;):format(UiKit.money(amount))
	end
end

function ShopUI.setVisible(visible: boolean)
	frame.Visible = visible
end

function ShopUI.isVisible(): boolean
	return frame.Visible
end

function ShopUI.refreshFromServer()
	local ok, catalog = pcall(function()
		return (Net.get(&quot;GetCatalog&quot;) :: RemoteFunction):InvokeServer()
	end)
	if ok and type(catalog) == &quot;table&quot; then
		ShopUI.render(catalog)
	end
end

return ShopUI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">UiKit</string><ProtectedString name="Source">--!strict
--[[
	UiKit — petits outils pour construire l'interface en code.

	Toute l'UI du jeu est créée par script, exprès : tu n'as aucun fichier .rbxm
	à importer, et tu peux relire à quoi ressemble un écran sans ouvrir Studio.
]]

local UiKit = {}

UiKit.Colors = {
	Panel = Color3.fromRGB(18, 18, 22),
	PanelLight = Color3.fromRGB(28, 28, 34),
	Text = Color3.fromRGB(236, 236, 240),
	Muted = Color3.fromRGB(150, 150, 160),
	Cash = Color3.fromRGB(120, 225, 150),
	Danger = Color3.fromRGB(255, 86, 72),
	Unlock = Color3.fromRGB(190, 130, 255),
	Accent = Color3.fromRGB(120, 160, 255),
}

--[[ Crée une instance et applique les propriétés. `children` est optionnel. ]]
function UiKit.new(className: string, props: { [string]: any }?, children: { Instance }?): Instance
	local instance = Instance.new(className)
	if props then
		for key, value in pairs(props) do
			if key ~= &quot;Parent&quot; then
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = instance
		end
	end
	if props and props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function UiKit.corner(radius: number): UICorner
	local corner = Instance.new(&quot;UICorner&quot;)
	corner.CornerRadius = UDim.new(0, radius)
	return corner
end

function UiKit.padding(amount: number): UIPadding
	local padding = Instance.new(&quot;UIPadding&quot;)
	padding.PaddingTop = UDim.new(0, amount)
	padding.PaddingBottom = UDim.new(0, amount)
	padding.PaddingLeft = UDim.new(0, amount)
	padding.PaddingRight = UDim.new(0, amount)
	return padding
end

function UiKit.stroke(color: Color3, thickness: number): UIStroke
	local stroke = Instance.new(&quot;UIStroke&quot;)
	stroke.Color = color
	stroke.Thickness = thickness
	stroke.Transparency = 0.5
	return stroke
end

--[[ Formate un montant en dollars, avec séparateur de milliers. ]]
function UiKit.money(amount: number): string
	local rounded = math.floor(amount + 0.5)
	local text = tostring(math.abs(rounded))
	local grouped = &quot;&quot;
	while #text &gt; 3 do
		grouped = &quot; &quot; .. text:sub(-3) .. grouped
		text = text:sub(1, -4)
	end
	grouped = text .. grouped
	if rounded &lt; 0 then
		grouped = &quot;-&quot; .. grouped
	end
	return grouped .. &quot; $&quot;
end

--[[ Formate un temps en m:ss. ]]
function UiKit.clockText(seconds: number): string
	local total = math.max(0, math.floor(seconds + 0.5))
	return (&quot;%d:%02d&quot;):format(math.floor(total / 60), total % 60)
end

return UiKit
</ProtectedString></Properties></Item></Item></Item></Item></roblox>
	})
end

local function buildSleepPanel(parent: Instance)
	local panel = new(&quot;Frame&quot;, {
		Name = &quot;SleepPanel&quot;,
		Parent = parent,
		BackgroundColor3 = Colors.Panel,
		BackgroundTransparency = 0.1,

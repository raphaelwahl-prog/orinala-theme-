<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><External>null</External><External>nil</External><Item class="Workspace" referent="RBX35"><Properties><string name="Name">Workspace</string><bool name="FilteringEnabled">true</bool></Properties></Item><Item class="Lighting" referent="RBX36"><Properties><string name="Name">Lighting</string><float name="Brightness">2</float><float name="ClockTime">7.2</float><token name="Technology">2</token><float name="FogEnd">420</float></Properties></Item><Item class="ReplicatedStorage" referent="RBX8"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX7"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">CosmeticCatalog</string><ProtectedString name="Source">--!strict
--[[
	CosmeticCatalog — skins et effets achetables avec l'argent du jeu.

	Règle absolue : **rien ici ne donne le moindre avantage.** Pas de vitesse,
	pas de réduction de risque, pas de gain. Que du visuel.

	Pourquoi c'est une règle et pas une préférence : le jour où un skin rend
	meilleur, les joueurs qui ne l'ont pas arrêtent de jouer, et ceux qui l'ont
	s'ennuient. Les cosmétiques doivent se vendre parce qu'ils donnent un STATUT,
	pas parce qu'ils donnent de la puissance.

	Et c'est justement pour ça que les meilleurs skins ne s'achètent pas avec de
	l'argent seulement : ils demandent une PREUVE. « Survivre une nuit dans Le
	Nid » n'est pas un prix, c'est un trophée — et un trophée que les autres
	voient sur toi, c'est le meilleur moteur de rétention qui existe.

	Emplacements (un équipé à la fois par emplacement) :
	  Skin · Trail · Aura · Title · BedSkin
]]

export type Requirement = {
	TotalBanked: number?,
	DeepestTier: number?,
	NightsSurvived: number?,
}

export type Cosmetic = {
	Id: string,
	Name: string,
	Desc: string,
	Slot: string,
	Price: number,
	Order: number,
	Requires: Requirement?,
	-- données visuelles, lues par CosmeticService
	Color: Color3?,
	Color2: Color3?,
	Material: Enum.Material?,
	Transparency: number?,
	LightRange: number?,
	Text: string?,
}

local CosmeticCatalog = {}

CosmeticCatalog.Slots = { &quot;Skin&quot;, &quot;Trail&quot;, &quot;Aura&quot;, &quot;Title&quot;, &quot;BedSkin&quot; }

CosmeticCatalog.Items = {
	-- ── SKINS (couleur + matière du personnage) ─────────────────────────────
	{
		Id = &quot;skin_default&quot;,
